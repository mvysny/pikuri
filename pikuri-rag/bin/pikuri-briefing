#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only. The pikuri
# gem ships as a library; this script is not installed by `gem install
# pikuri-rag`.
#
# The one-legged agent: it briefs you on a customer from your own
# hand-written meeting notes and holds exactly one of the lethal
# trifecta's three legs. Private data, yes — every note is a record of a
# customer relationship. Untrusted input, no: you wrote every byte.
# Egress, no: there is no web search, no page fetch, no mail, no shell.
# The map it prints at boot says `1 of 3 legs (private)`, and the
# security chapter explains why that is an inert agent rather than a
# quiet one. Walk-through: book/rag.md.
#
# `--with-mail` IS THE SECOND STAGE, AND IT IS A CONTROLLED EXPERIMENT.
# It adds read-only local mail, so the agent goes from one leg to two
# (`2 of 3 legs (private, untrusted)`) while the verdict stays silent —
# no egress, so presence never completed a trifecta. Run both in one
# sitting: the map's count moves, the meaning-carrying half of the
# advisory says nothing new, and what actually changed is what *you*
# owe every claim in the brief. That is the lesson, and the flag exists
# so the diff is one word rather than two binaries.
#
# The flag *raises* when mail could not be wired, inverting the
# extension's own deliberate fail-open (no Thunderbird profile, or no
# Gloda index ⇒ log at info and carry on). Right default for a general
# host; wrong here, because this binary has just told you it added a
# private + untrusted leg, and a boot map reading `1 of 3` under
# `--with-mail` would leave you believing you ran the second stage.
#
# LOCAL INFERENCE IS THIS AGENT'S FIRST INVARIANT, not a preference. The
# trifecta model does not count the inference provider as egress; a user
# who says "these notes stay on my machine" does. Point it at a cloud
# model and every customer note ships to that provider by design, and the
# one-legged story is false at the transport level. The default config
# below is a llama-server on localhost; keep it that way.
#
# TWO DECLARATIONS ARE HARDCODED, deliberately, where bin/pikuri-corpus
# takes them as flags — see design/decisions.md D_briefing_wiring. This binary
# has no honest non-private reading, so a flag would make the honest map
# opt-in and the documented invocation the flagged one. `trusted: true`
# is a claim about a folder *you* supply through --source, so the boot
# text states the claim in words rather than leaving it to the map.
#
# PASTE NOTHING; PARAPHRASE. `trusted: true` holds only while the notes
# are your own writing. A customer e-mail pasted into a note is text
# somebody else wrote, indexed within seconds by the watcher, and
# retrieved from then on as content you vouched for. Nothing can detect
# it. Write in your own words.
#
# Same Bundler bootstrap pattern as the other bundled bins so callers
# don't need the `bundle exec` ceremony.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../Gemfile', __dir__)

require 'bundler/setup'
require 'digest'
require 'optparse'
require 'yaml'
require 'reline' # line editing + history for the interactive prompt

require 'pikuri-core'
require 'pikuri-rag'
# Checkout-mode-only require (this gem's gemspec doesn't declare it —
# bins run from the monorepo Gemfile): plugs PDF extraction into the
# Extractor registry below, so a customer's PDF dropped in the notes
# folder indexes alongside the Markdown. Read Indexer#trusted?'s first
# clause before you do that: a rendered PDF is a proxy for the bytes the
# model reads.
require 'pikuri-pdf'
# Also checkout-mode-only (not in this gem's gemspec): the read-only mail
# surface --with-mail wires. Nothing is registered unless the flag is on.
require 'pikuri-thunderbird'

# Example-only config: the LLM connection + provider API keys live verbatim
# in a YAML file the user owns — no CLI flags, never the environment (see
# AGENTS.md "Environment is not a secret store"). Shared by convention across
# the example scripts; chmod 600 it. Absent file ⇒ {} ⇒ built-in defaults.
examples_config_path = File.expand_path('~/.pikuri-examples-config.yaml')
examples_config = File.exist?(examples_config_path) ? (YAML.safe_load_file(examples_config_path) || {}) : {}

server          = examples_config['llm_server'] || 'http://localhost:8080'
model           = examples_config['llm_model'] || 'ornith-ai/Ornith-1.5-35B-A3B-GGUF:Q4_K_M'
embed_model     = examples_config['embed_model'] || 'nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0'
reranker_server = examples_config['reranker_server'] # nil ⇒ defaults to +server+ below
reranker_model  = examples_config['reranker_model'] || 'gpustack/bge-reranker-v2-m3-GGUF:Q8_0'
use_reranker    = true
source          = File.expand_path('~/notes')
# Inverted from bin/pikuri-corpus, and for the same kind of reason the
# declarations are constants: there, the manual reindex *is* the teaching
# device. Here a note you wrote this morning missing from the brief is a
# silent hole, and the read tool's membership gate rejects it outright —
# loud and actionable, but baffling for a note that plainly exists on
# disk. Keep the index live by default.
watch           = true
use_qdrant      = false
with_mail       = false

custom_prompt = nil
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-briefing [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--source PATH', "Notes folder to index (default: #{source})") { |v| source = v }
  opts.on('--no-watch', 'Do not keep the index live; index once at boot instead') { watch = false }
  opts.on('--no-reranker', 'Skip the reranker; use the fused top-k') { use_reranker = false }
  opts.on('--with-mail',
          'Also read your local Thunderbird mail and contacts (read-only). Adds the ' \
          'untrusted leg: the agent goes from 1 of 3 to 2 of 3 legs, and the private ' \
          'pool becomes your whole mailbox. Fails if mail cannot be wired') { with_mail = true }
  opts.on('--qdrant',
          'Persist the index in a self-managed Qdrant container (requires podman or docker) ' \
          'plus a keyword index under the pikuri cache, so a corpus indexed once ' \
          'stays indexed across runs') { use_qdrant = true }
  opts.on('--system-prompt FILE', "Replace the built-in system prompt with FILE's contents " \
                                  '(extensions still append their own sections).') do |v|
    custom_prompt = File.read(v).rstrip
  end
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

source = File.expand_path(source)
unless File.directory?(source)
  warn "Notes folder not found: #{source}"
  warn 'Point --source at the folder holding your meeting notes.'
  exit 2
end

# The chat transport, the embedder and the reranker each build their own
# connection from their server, re-appending +/v1+ themselves.
api_key         = examples_config.fetch('llm_api_key', 'not-needed')
reranker_server ||= server

# Explicit opt-in (requiring pikuri-pdf alone changes nothing).
Pikuri::Extractors::PDF.register

cancel_flag = Pikuri::Agent::Control::Cancellable.new

# One shared prompt for both stages, plus a fragment appended under the
# flag — so the base cannot drift between the two readings, and neither
# stage's prompt claims a source the agent has no way to reach. (The mail
# surface's own search-and-ground discipline arrives with the extension,
# not from here; the fragment owns only what no gem can know — that one
# source is the user's own writing and the other is not.)
system_prompt = custom_prompt || Pikuri.prompts(*[:'pikuri-briefing',
                                                  (:'pikuri-briefing-mail' if with_mail),
                                                  :'agent-loop'].compact)
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"
system_prompt += "\nIndexed notes folder: #{source}"

reranker = use_reranker ? Pikuri::VectorDb::Reranker::LlamaServer.new(
  server:   reranker_server,
  model:    reranker_model,
  api_key:  examples_config['llm_api_key']
) : nil

embedder = Pikuri::VectorDb::Embedder.new(server: server, model: embed_model, api_key: api_key)

# One collection per notes root, not one fixed name: a persistent backend
# keeps whatever it was given, so a shared name would serve yesterday's
# --source under today's declaration (the collection clause of
# Indexer#trusted?).
corpus_key = File.realpath(source)
collection = "pikuri-briefing-#{Digest::SHA256.hexdigest(corpus_key)[0, 12]}"

# The two stores are paired, per Rag::Backend::Hybrid's "which keyword store
# to pair with which vector store": RAM with RAM, and a file beside Qdrant so both
# survive a restart. A mismatch would still be *correct* — Hybrid's
# both-stores rule repairs it — just slower, at a full re-embed per boot.
server_class = use_qdrant ? Pikuri::VectorDb::Server::Qdrant : Pikuri::VectorDb::Server::InMemory
store = if use_qdrant
          Pikuri::Paths.cache.tap { |dir| dir.mkpath }.join("#{collection}.sqlite3").to_s
        else
          Pikuri::Rag::Backend::Fts5::MEMORY_STORE
        end

begin
  vector_server = server_class.ensure_running
  vector_backend = vector_server.client(collection: collection)
rescue StandardError => e
  warn "Could not start #{server_class.name.split('::').last}: #{e.message}"
  warn 'Is podman or docker installed and working? Drop --qdrant to use the in-memory backend.' if use_qdrant
  exit 1
end

# One indexer for the corpus: the agent's tools and the watcher below share it.
indexer = Pikuri::VectorDb::Indexer.new(
  backend:  Pikuri::Rag::Backend::Hybrid.new(vectors: vector_backend, keywords: Pikuri::Rag::Backend::Fts5.new(store: store)),
  source:   source,
  embedder: embedder,
  # Constants, not flags — see the header and design/decisions.md D_briefing_wiring.
  private:  true,
  trusted:  true
)
rag_ext = Pikuri::Rag::Extension.new(indexer: indexer, reranker: reranker)

# Run one agent turn, trapping SIGINT only for the duration of the turn.
def run_turn(agent, message)
  agent.cancellable&.reset!
  prev_trap = trap('INT') { agent.cancellable&.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener; nothing else to do.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

# Mail and contacts, never the calendar: "which meeting is coming up"
# would be genuinely useful and is exactly the scope creep to resist
# until asked, and a calendar is a third private surface an injected
# message could make the agent query. Contacts is in because the sharp
# mail filters want an address, and free-text on a customer's name finds
# every message that merely mentions them.
tb_ext = with_mail ? Pikuri::Thunderbird::Extension.new(surfaces: %i[mail contacts]) : nil

agent = Pikuri::Agent.new(
  transport: Pikuri::Agent::ChatTransport.from_openai_server(server: server, model: model, api_key: api_key),
  system_prompt: system_prompt,
  cancellable: cancel_flag,
  streaming: false
) do |c|
  c.add_listener Pikuri::Agent::Listener::Terminal.new(streaming: false)
  c.add_listener Pikuri::Agent::Listener::TokenLog.new
  # The corpus tools, plus read-only mail under --with-mail, and nothing
  # else. No web, no bash, no memory gem: the notes folder *is* the
  # durable memory here, written by hand, already distilled —
  # auto-extracting from it would summarize a summary. Under --with-mail
  # memory would be worse than redundant: it would carry facts distilled
  # from untrusted mail into every later conversation, unattributed.
  c.add_extension rag_ext
  c.add_extension tb_ext if tb_ext
end

# The inversion the header explains: asking for mail and silently not
# getting it would leave the boot map reading `1 of 3` under a flag whose
# whole purpose is the second leg. Loud, with the two causes named.
if with_mail && !tb_ext.mail_wired?
  agent.close
  warn 'Could not wire mail: no Thunderbird profile found, or the profile has no Gloda index.'
  warn 'Enable Thunderbird\'s global search (Preferences → General → Enable Global Search'
  warn 'and Indexer), let it index, and try again — or drop --with-mail for the notes-only agent.'
  exit 2
end

watcher = watch ? Pikuri::VectorDb::Watcher.new(indexer: indexer).start : nil
unless watch
  # The --watch path degrades on its own (the Watcher logs a failed file and
  # moves on), but this synchronous call would take the whole boot down before
  # the trifecta map ever prints — and the likeliest cause is a llama-server
  # that isn't up yet, which is worth a sentence rather than a backtrace.
  begin
    indexer.index_if_empty!
  rescue StandardError => e
    warn "Could not index #{source}: #{e.class}: #{e.message}"
    warn "Is the embedder reachable at #{server}? Starting anyway — ask me to reindex once it is."
  end
end

begin
  # Capability + trifecta map, printed unconditionally. These are teaching
  # binaries and the map is half the lesson; a production host puts it behind
  # an explicit ask instead.
  puts agent.trifecta.render
  puts
  puts 'Pikuri Briefing: prepares you for a customer meeting from your own notes' \
       "#{with_mail ? ' and your local mail' : ''} (no internet access)."
  puts "Notes: #{source}"
  # The claim this binary just made on the user's behalf, in words. One
  # puts beside the map: cheap, and it cannot fail silent the way a
  # forgotten flag would.
  puts "Indexing #{source} as PRIVATE and TRUSTED — that means: you reviewed every note in the"
  puts '  form the model reads it, nobody else writes into that folder, and the index holds'
  puts '  nothing but what that folder put there. Paste nothing from a customer; paraphrase.'
  # The map above just moved from 1 of 3 legs to 2 of 3 and its verdict
  # stayed silent, which is correct and says nothing about what changed
  # for *you*. On a silent verdict the advisory prints presence only — no
  # attribution, no advice — so these four lines are the only place the
  # obligation change is stated. Same reason the TRUSTED claim above is
  # words rather than a map row.
  if with_mail
    puts
    puts 'MAIL IS ON, and this is the two-legged reading. Two things it changes:'
    puts '  The pool is your WHOLE MAILBOX and address book, not your correspondence with one'
    puts '  customer — that is a promise in the prompt, not a boundary anything enforces.'
    puts '  And a message is text somebody else wrote, so a brief can now be steered by one.'
    puts '  Nothing can leave this machine either way, so the trifecta is still broken; what'
    puts '  changed is that a claim from mail is one you may have to check out of band.'
  end
  puts "Backend: #{use_qdrant ? 'Qdrant (persistent)' : 'InMemory (RAM-only)'}, " \
       "keyword index: #{store == Pikuri::Rag::Backend::Fts5::MEMORY_STORE ? 'in-memory' : store}"
  indexed = indexer.backend.count
  if indexed.positive?
    puts "Index populated (#{indexed} chunk(s))."
  elsif watch
    puts 'Index is building in the background now — give it a moment before the first question.'
  else
    puts 'Index is empty and nothing was found to index. Check --source.'
  end
  puts 'Naming your notes <customer>-<date>.md is what lets a brief order events by date.'
  puts 'Try: "brief me on Acme — what did we discuss last, and what did we commit to?"'
  puts 'Press Ctrl+C or Ctrl+D to quit.'

  run_turn(agent, ARGV.join(' ')) unless ARGV.empty?

  loop do
    line = Reline.readline('> ', true) # arrow-key history + line editing
    break if line.nil? # Ctrl+D / EOF on empty line

    message = line.chomp
    next if message.strip.empty?

    run_turn(agent, message)
  end
rescue Interrupt
  # Ctrl+C — fall through to clean exit
ensure
  # Teardown in reverse of open order: stop the indexing daemon first
  # (halt writes), release the agent, close the index, then the vector
  # server (a podman/docker supervisor removes its container).
  watcher&.close
  agent.close
  indexer.close
  vector_server.close
end

puts
puts 'Goodbye'
