#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only; no gem installs
# it.
#
# Builds the demo world the secretary chapter's transcripts run on: Alex
# Novak's mailbox, calendar and ~/Documents, from book/demo/ (facts.yml,
# mail.yml, documents/). Every domain is RFC 2606-reserved, so no real mail
# is ever in it. A real headless Thunderbird builds the stores pikuri reads,
# from the mbox and .ics files this writes.
#
#   bin/pikuri-demo-mailbox                    # the VM: Thunderbird's default profile + ~/Documents
#   bin/pikuri-demo-mailbox --dir ~/pikuri-demo  # beside your real profile, which it never touches
#
# With --dir, the folder holds profile/ and Documents/; it prints how to run
# Thunderbird and the secretary on them. A snap Thunderbird can't read a
# hidden directory in $HOME, so don't pick one.
#
# It refuses to run while a Thunderbird root holds a profile that isn't a
# pikuri demo (no .pikuri-demo marker), or while a folder it would write is
# non-empty and unmarked, and never deletes one.

require 'bundler/setup'
require 'date'
require 'fileutils'
require 'optparse'
require 'pikuri-core'

Dir[File.expand_path('../book/demo/builder/*.rb', __dir__)].each { |f| require f }

$stdout.sync = true

options = { dir: nil, today: Date.today, rebuild: false }
OptionParser.new do |o|
  o.banner = 'Usage: pikuri-demo-mailbox [--dir DIR] [--today YYYY-MM-DD]'
  o.on('--dir DIR', 'Build here, outside Thunderbird\'s profile roots; profiles.ini untouched') { |v| options[:dir] = v }
  o.on('--today DATE', 'Date the mailbox is relative to (default: today)') { |v| options[:today] = Date.iso8601(v) }
  o.on('--rebuild', 'Index afresh even when a cached profile matches') { options[:rebuild] = true }
end.parse!

tzid = File.readlink('/etc/localtime')[%r{zoneinfo/(.+)\z}, 1] || 'UTC'
target = Pikuri::Demo::Target.for(dir: options[:dir])
cache_dir = Pikuri::Paths.cache.join('demo-mailbox')
FileUtils.mkdir_p(cache_dir)
log = cache_dir.join('thunderbird.log').to_s

begin
  target.guard!
  converter = Pikuri::Demo::Converter.new(cache_dir: cache_dir.join('converted').to_s)
  content = Pikuri::Demo::Content.new(today: options[:today], tzid: tzid, converter: converter)
  puts "Building #{content.message_count} messages and #{content.event_count} events into #{target.profile_dir}"
  puts "and #{content.documents.files.size} documents into #{target.documents_dir}"
  builder = Pikuri::Demo::Builder.new(target: target, content: content, cache_dir: cache_dir.to_s, log: log)
  seconds = builder.build!(rebuild: options[:rebuild])
rescue Pikuri::Demo::Target::Refused => e
  abort e.message
end
puts(seconds ? format('Indexed in %.1fs. Thunderbird\'s log: %s', seconds, log) : "Restored from the cache in #{cache_dir}.")
puts(if target.registered?
       'Registered as the default profile; pikuri finds it on its own.'
     else
       "Run Thunderbird on it: thunderbird -profile #{target.profile_dir} --no-remote\n" \
         "Run the secretary on it: bin/pikuri-secretary --documents #{target.documents_dir} " \
         "--thunderbird-profile #{target.profile_dir}"
     end)
