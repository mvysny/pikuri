#!/usr/bin/env bash
# Symlink pikuri-chat and pikuri-code into $PREFIX (default ~/.local/bin) so
# they're on $PATH. The scripts pin BUNDLE_GEMFILE to this checkout's Gemfile,
# so they work from any working directory once installed.
#
# Usage:
#   ./bin/install                # install into ~/.local/bin
#   PREFIX=~/bin ./bin/install   # install into a different directory
set -euo pipefail
IFS=$'\n\t'

DEST="${PREFIX:-$HOME/.local/bin}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Each pikuri binary lives in its own gem's bin/ directory after the
# Phase 2 monorepo split. Until every binary has been extracted to
# its gem subdir, some are still at the repo-level bin/.
declare -A BINARIES=(
  [pikuri-chat]="$ROOT/pikuri-core/bin/pikuri-chat"
  [pikuri-code]="$ROOT/pikuri-code/bin/pikuri-code"
  [pikuri-assistant]="$ROOT/bin/pikuri-assistant"
)

mkdir -p "$DEST"
for name in "${!BINARIES[@]}"; do
  src="${BINARIES[$name]}"
  ln -sfn "$src" "$DEST/$name"
  echo "  $DEST/$name -> $src"
done

case ":$PATH:" in
  *":$DEST:"*) ;;
  *) echo; echo "note: $DEST is not on \$PATH" ;;
esac
