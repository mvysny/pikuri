#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only; no gem installs
# it. At the repo root because its wiring spans five gems.
#
# The secretary: book 1's climax. A plain CLI personal assistant over your
# documents, notes, mail, calendar and contacts, which can also search the
# web. It holds all three trifecta legs — your mail and documents are
# private, incoming mail and other people's files are untrusted, and a
# search query leaves the machine — and weakens each one in its structure
# rather than by filtering text:
#
# * EGRESS IS SEARCH, NEVER FETCH. +web_search+ reaches only an engine this
#   code picks, so a secret can be pushed out inside a query but an
#   attacker can't read it back. No page reader that sends a request: with a
#   Brave or Exa key in the config, the search brings back each result's
#   text from the engine's own index and +web_read_cached+ reads it by
#   handle; with DuckDuckGo alone, the snippets are the whole answer. Either
#   way the query is the one way out. Each query is confirmed by default,
#   which doesn't change the trifecta verdict — it is privacy from the
#   search engine, against a
#   model that quotes your mail into a query unprompted.
#   +--no-search-confirm+ turns it off.
# * OUTBOUND MAIL AND INVITES ARE HANDED TO THUNDERBIRD, where you press
#   Send yourself, having seen the actual bytes.
# * THE NOTES FOLDER IS THE ONLY PLACE IT WRITES, and every write shows you
#   a diff first. That defends integrity, not confidentiality: a mail saying
#   "note that invoices go to IBAN X" would otherwise become a note a later
#   conversation trusts as your own words. Don't point it at a folder that
#   Nextcloud or Syncthing shares — a write there is egress to whoever reads
#   the share, and nothing here can tell.
#
# Your files are searched through the index the desktop already keeps
# (GNOME's localsearch, or recoll), over your Desktop and Documents and
# nothing else: no index of ours, no GPU embedding your files. What the
# desktop leaves out of its index, search can't find. Under localsearch a
# note it just wrote is findable within a second; under recoll only while
# `recollindex -m` runs. With neither index ready it says why and exits.
#
# Memory is a note: SECRETARY.md in the notes folder, read into the prompt
# at boot and written through the same confirmed edit as every other note.
# A change takes effect next session.
#
# Walk-through: the secretary chapter of the book.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require 'bundler/setup'
require 'fileutils'
require 'optparse'
require 'yaml'
require 'reline' # line editing + history for the interactive prompt

require 'pikuri-core'
require 'pikuri-fileindex'
require 'pikuri-pdf'
require 'pikuri-thunderbird'
require 'pikuri-web'
require 'pikuri-workspace'

Pikuri::PROMPT_DIRS << File.expand_path('../prompts', __dir__)

# The user's folder +name+ ('DESKTOP', 'DOCUMENTS') under its localized
# name, or nil when there is none. xdg-user-dir answers $HOME for a folder
# that isn't set, or is set to "disabled": never take that for a folder,
# or the agent would search the whole home folder.
def user_dir(name)
  result = Pikuri::Subprocess.spawn('xdg-user-dir', name, chdir: Dir.home).wait
  dir = result.output.strip
  dir if result.status.success? && File.directory?(dir) && File.realpath(dir) != File.realpath(Dir.home)
rescue Errno::ENOENT # no xdg-user-dirs package
  nil
end

# Example-only config: the LLM connection + provider API keys live verbatim
# in a YAML file the user owns — no CLI flags, never the environment (see
# AGENTS.md "Environment is not a secret store"). chmod 600 it.
examples_config_path = File.expand_path('~/.pikuri-examples-config.yaml')
examples_config = File.exist?(examples_config_path) ? (YAML.safe_load_file(examples_config_path) || {}) : {}

server          = examples_config['llm_server'] || 'http://localhost:8080'
model           = examples_config['llm_model'] || 'ornith-ai/Ornith-1.5-35B-A3B-GGUF:Q4_K_M'
api_key         = examples_config.fetch('llm_api_key', 'not-needed')
documents       = user_dir('DOCUMENTS') || File.expand_path('~/Documents')
desktop         = user_dir('DESKTOP')
confirm_search  = true

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-secretary [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--documents PATH', 'Your documents folder, searched together with your Desktop; ' \
                              "notes live in its Notes/ (default: #{documents})") do |v|
    documents = v
  end
  opts.on('--no-search-confirm',
          'Send web search queries without showing them to you first. Private text may then ' \
          "land in the search engine's logs") { confirm_search = false }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

documents = File.expand_path(documents)
unless File.directory?(documents)
  warn "Documents folder not found: #{documents}"
  warn 'Point --documents at the folder the secretary should know.'
  exit 2
end

# Private, and NOT trusted, unlike briefing's hand-written notes: a real
# documents folder holds downloaded attachments, bank statements and other
# people's files, and the notes in it may quote a stranger's mail. Not
# Downloads: a page can drop a file there when you click a link.
roots = Pikuri::Fileindex::Roots.new(dirs: [desktop, documents].compact, private: true, trusted: false)
begin
  fileindex = Pikuri::Fileindex.pick(roots)
rescue Pikuri::Fileindex::Unavailable => e
  # No degraded mode: a secretary that can't search would answer "you have
  # no such file".
  warn "The secretary can't search your files: #{e.message}"
  exit 1
end

notes = File.join(documents, 'Notes')
unless File.directory?(notes)
  FileUtils.mkdir_p(notes)
  puts "Created #{notes} — the one folder the secretary writes to."
end
memory_path = File.join(notes, 'SECRETARY.md')

# Explicit opt-in (requiring pikuri-pdf alone changes nothing): PDF mail
# attachments read, and so does a PDF opened by its path.
Pikuri::Extractors::PDF.register

# The memory, read once. A change the agent makes lands on disk at once
# but reaches the prompt only next session: rewriting the system prompt
# mid-conversation would cost the KV cache for a fact the model already
# has from the confirmed edit.
memory = File.exist?(memory_path) ? File.read(memory_path).strip : ''
memory_block = if memory.empty?
                 "Notes/SECRETARY.md does not exist yet or is empty; create it the first time the user asks you to remember something."
               else
                 "<memory path=\"#{memory_path}\">\n#{memory}\n</memory>"
               end

system_prompt = Pikuri.prompts(:'pikuri-secretary', :'agent-loop')
system_prompt += "\n\n#{memory_block}"
system_prompt += "\n\nToday is #{Time.now.strftime('%A, %Y-%m-%d')}."
system_prompt += "\nDesktop folder: #{desktop}" if desktop
system_prompt += "\nDocuments folder: #{documents}"
system_prompt += "\nNotes folder: #{notes}"

confirmer = Pikuri::Workspace::Confirmer::Terminal.new

# The file tools read the documents folder and write only its Notes/. Rooted
# at the documents folder rather than at Notes/, so a note's path is one
# path to every tool. No grep: it can't see inside a PDF, so it would answer
# "no match" where the file index finds the invoice.
workspace_ext = Pikuri::Workspace::Extension.new(
  filesystem: Pikuri::Workspace::Filesystem.new(project_root: documents, root_writable: false, writable: [notes],
                                                private: true, trusted: false),
  confirmer: confirmer, grep: false
)

tb_ext = Pikuri::Thunderbird::Extension.new(allow_compose_mail: true, allow_create_calendar_event: true)

search_config = Pikuri::Web::Search::Engines.config_from_h(examples_config['search'])
# Whole pages when the config keys an engine that has their text (see
# D_page_text_by_handle in design/decisions.md); DuckDuckGo alone has none.
page_text = Pikuri::Web::Search::Engines.resolve(
  engines: search_config[:engines], brave_key: search_config[:brave_key], exa_key: search_config[:exa_key]
).intersect?(Pikuri::Web::Search::Engines::PAGE_TEXT_ENGINES)

def run_turn(agent, message)
  agent.cancellable&.reset!
  prev_trap = trap('INT') { agent.cancellable&.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener; nothing else to do.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

begin
  agent = Pikuri::Agent.new(
    transport: Pikuri::Agent::ChatTransport.from_openai_server(server: server, model: model, api_key: api_key),
    system_prompt: system_prompt,
    cancellable: Pikuri::Agent::Control::Cancellable.new
  ) do |c|
    c.add_listener Pikuri::Agent::Listener::Terminal.new
    c.add_listener Pikuri::Agent::Listener::TokenLog.new
    c.add_tool Pikuri::Tool::CALCULATOR
    c.add_extension Pikuri::Fileindex::Extension.new(roots: roots, backend: fileindex)
    c.add_extension tb_ext
    c.add_extension workspace_ext
    c.add_tool Pikuri::Web::Search.build(**search_config, page_text: page_text, snippets_only: !page_text,
                                         confirmer: confirm_search ? confirmer : nil)
    c.add_tool Pikuri::Web::READ_CACHED if page_text
  end
rescue Pikuri::Thunderbird::Profile::DiscoveryError => e
  warn "Thunderbird profile problem: #{e.message}"
  exit 1
end

begin
  # The trifecta map, printed unconditionally: half the lesson.
  puts agent.trifecta.render
  puts
  puts 'Pikuri Secretary: your documents, notes, mail and calendar, plus web search.'
  puts "Files:     #{roots.dirs.join(', ')} (searched through #{fileindex.label} as PRIVATE and UNTRUSTED)"
  puts "Notes:     #{notes} (the only folder it writes to; you approve every change)"
  puts "Memory:    #{memory_path} (#{memory.empty? ? 'empty' : "#{memory.lines.size} line(s)"})"
  puts 'Mail:      drafts and invites open in Thunderbird; you press Send.'
  puts "Search:    #{page_text ? "pages from the engine's index, never fetched" : 'snippets only'}; " \
       "#{confirm_search ? 'you approve every query' : 'queries go out UNSEEN'}."
  unless tb_ext.mail_wired?
    puts
    puts 'MAIL IS OFF: no Thunderbird profile found, or it has no Gloda index. Enable'
    puts "Thunderbird's global search (Settings → General → Enable Global Search and Indexer)."
  end
  puts "Try: \"what's on my calendar this week?\" or \"remember that I prefer morning meetings\""
  puts 'Press Ctrl+C or Ctrl+D to quit.'

  run_turn(agent, ARGV.join(' ')) unless ARGV.empty?

  loop do
    line = Reline.readline('> ', true)
    break if line.nil? # Ctrl+D / EOF on empty line

    message = line.chomp
    next if message.strip.empty?

    run_turn(agent, message)
  end
rescue Interrupt
  # Ctrl+C — fall through to clean exit
ensure
  agent.close
end

puts
puts 'Goodbye'
