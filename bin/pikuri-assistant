#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only. The pikuri
# gem ships as a library; this script is not installed by `gem install
# pikuri`. It exists to demonstrate how to wire Pikuri::Agent +
# Pikuri::Tool::* + Pikuri::Mcp::Servers into a working assistant binary
# with access to OAuth-gated SaaS via MCP, and to support development.
# Production binaries built on pikuri (e.g. the planned pikuri-tui)
# live in their own gems.
#
# This binary differs from `pikuri-chat` in three places:
#   * +prompts/pikuri-assistant.txt+ — assistant voice + MCP-aware
#     guidance.
#   * The +Mcp::Registry+ block below — hand-edit to add MCP servers
#     (id + argv pair). Empty by default so a fresh checkout runs
#     identically to `pikuri-chat` until the user opts in.
#   * The MCP audit log fires at INFO via `Pikuri.logger_for('Mcp::Servers')`
#     once servers start.
#
# Pin Bundler to pikuri's own Gemfile so locked dependency versions win
# and the script works when invoked via a symlink (e.g. ~/.local/bin/
# pikuri-assistant) from any working directory. `__dir__` resolves
# through symlinks, so this points at the real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require 'bundler/setup'
require 'optparse'

require 'pikuri-core'
require 'pikuri-mcp'

server = 'http://localhost:8080'
model = 'unsloth/Qwen3.6-35B-A3B-GGUF'
streaming = false

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-assistant [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--server URL', "LLM server base URL (default: #{server})") { |v| server = v }
  opts.on('--model NAME', "Model identifier (default: #{model})") { |v| model = v }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

server = server.chomp('/')
openai_api_base = "#{server}/v1"

RubyLLM.configure do |c|
  c.openai_api_base = openai_api_base
  c.openai_api_key  = 'not-needed'
end

# llama.cpp exposes the server's launched +n_ctx+ at +/props+ on the base
# host (NOT under +/v1+). Hand the derived URL to {Agent::ContextWindowDetector}
# so the +ctx=<used>/<cap>+ headline lights up against this local server,
# which is unknown to ruby_llm's bundled model registry.
llama_probe_url = "#{server}/props"

cancel_flag = Pikuri::Agent::Control::Cancellable.new

system_prompt = Pikuri.prompt(:'pikuri-assistant')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

# MCP servers available to the assistant. Hand-edit this array to add
# providers — id is what the LLM references via +mcp_connect("...")+.
# Two entry types: +StdioEntry+ for a local subprocess (argv to spawn)
# and +HttpEntry+ for a remote endpoint (url + optional headers). Empty
# by default; pikuri-assistant will behave identically to pikuri-chat
# until at least one entry is added here.
#
# == Examples
#
#   Pikuri::Mcp::Registry::StdioEntry.new(
#     id:      'maven-tools',
#     command: ['npx', 'mcp-maven-deps']
#   ),
#   Pikuri::Mcp::Registry::StdioEntry.new(
#     id:      'gmail',
#     command: ['npx', '@gongrzhe/server-gmail-autoauth-mcp']
#   ),
#   Pikuri::Mcp::Registry::HttpEntry.new(
#     id:      'hubspot',
#     url:     'https://mcp.example.com/v1',
#     headers: { 'Authorization' => "Bearer #{ENV.fetch('HUBSPOT_TOKEN')}" }
#   ),
mcp_registry = Pikuri::Mcp::Registry.new(entries: [
])

# Boot-time LLM work — synthesize_descriptions: + verify_mcp_servers:
# each call Agent.think once per configured MCP server on a cold
# cache (description synthesis on servers without instructions, then
# the injection verifier on every server). Both honor cancel_flag,
# so trap SIGINT around Agent.new and a Ctrl+C unwinds startup on
# the next .think check. Cached entries skip both passes entirely.
#
# The extension is constructed here (rather than inline inside the
# block) so we can read +mcp_ext.servers.live_ids+ for the startup
# banner below. The extension's +configure(c)+ runs synchronously
# inside the Configurator block, so by the time +Agent.new+ returns
# +mcp_ext.servers+ is set.
mcp_ext = Pikuri::Mcp::Extension.new(
  registry: mcp_registry,
  synthesize_descriptions: true,
  verify_mcp_servers: true
)
prev_boot_trap = trap('INT') { cancel_flag.cancel! }
begin
  agent = Pikuri::Agent.new(
    transport: Pikuri::Agent::ChatTransport.new(
      model: model,
      provider: :openai,
      assume_model_exists: true
    ),
    system_prompt: system_prompt,
    tools: [Pikuri::Tool::WEB_SEARCH, Pikuri::Tool::CALCULATOR, Pikuri::Tool::WEB_SCRAPE, Pikuri::Tool::FETCH],
    listeners: Pikuri::Agent::ListenerList.new([
      Pikuri::Agent::Listener::Terminal.new(streaming: streaming),
      Pikuri::Agent::Listener::TokenLog.new
    ]),
    step_limit: Pikuri::Agent::Control::StepLimit.new(max: 20),
    cancellable: cancel_flag,
    llama_probe_url: llama_probe_url,
    streaming: streaming
  ) do |c|
    c.add_extension mcp_ext
    c.allow_sub_agent(max_steps: 20)
  end
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  warn 'Cancelled during startup'
  exit 130
ensure
  trap('INT', prev_boot_trap || 'DEFAULT')
end
# The cancel flag may have been left in a tripped state if the user
# pressed Ctrl+C between MCP synthesis calls — the trap fired but
# Agent.new finished before the next .think check could raise. Reset
# so the first turn doesn't inherit a stale cancellation.
cancel_flag.reset!

# Release agent-owned resources — most importantly the MCP server
# subprocesses spawned at agent construction — on every exit path
# this script supports. Explicit #close is the user-facing
# contract for Pikuri::Agent; forgetting it would leak server
# subprocesses until process exit.
at_exit { agent.close }

# Trap SIGINT only for the duration of the agent's turn. Ctrl+C during a
# turn flips the Cancellable flag — the next tool-call boundary raises
# Cancelled, which we rescue below to return to the prompt. Outside a
# turn (at the `> ` input) the default handler is restored so Ctrl+C
# still exits the REPL the way it did before.
run_turn = lambda do |message|
  prev_trap = trap('INT') { cancel_flag.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener; nothing else to do.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

puts 'Pikuri Assistant. Press Ctrl+C or Ctrl+D to quit.'
if mcp_ext.servers && !mcp_ext.servers.empty?
  puts "MCP servers connected: #{mcp_ext.servers.live_ids.join(', ')}"
end

run_turn.call(ARGV.join(' ')) unless ARGV.empty?

begin
  loop do
    print '> '
    $stdout.flush
    line = $stdin.gets
    break if line.nil? # Ctrl+D / EOF on empty line

    message = line.chomp
    next if message.strip.empty?

    run_turn.call(message)
  end
rescue Interrupt
  # Ctrl+C — fall through to clean exit
end

puts
