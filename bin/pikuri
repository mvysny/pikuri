#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri'

RubyLLM.configure do |c|
  c.openai_api_base = 'http://192.168.122.1:8080/v1'
  c.openai_api_key  = 'not-needed'
end

agent = Agent.new(
  model: 'unsloth/Qwen3.6-35B-A3B-GGUF',
  provider: :openai,
  assume_model_exists: true,
  system_prompt: File.read("#{__dir__}/../smolagents-system-prompt.txt"),
  tools: [Tool::WEB_SEARCH, Tool::CALCULATOR, Tool::WEB_SCRAPE, Tool::FETCH],
  listeners: Agent::ListenerList.new([
    Agent::Listener::Terminal.new,
    Agent::Listener::TokenLog.new,
    Agent::Listener::StepLimit.new(max: 20)
  ])
)
agent.allow_sub_agent(max_steps: 20)

question =
  if ARGV.empty?
    print 'Question: '
    gets.to_s.chomp
  else
    ARGV.join(' ')
  end

begin
  agent.run_loop(user_message: question)
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
end
