#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'agent'
require 'openai_client'
require 'tool/calculator'
require 'tool/websearch'
require 'tool/web_fetch'

client = OpenAIClient.new(
  url: 'http://192.168.122.1:8080/v1',
  model: 'unsloth/Qwen3.6-35B-A3B-GGUF',
  api_key: 'not-needed'
)

agent = Agent.new(
  client: client,
  system_prompt: File.read("#{__dir__}/../smolagents-system-prompt.txt"),
  tools: [Tool::WEB_SEARCH, Tool::CALCULATOR, Tool::WEB_FETCH]
)
agent.allow_sub_agent

question =
  if ARGV.empty?
    print 'Question: '
    gets.to_s.chomp
  else
    ARGV.join(' ')
  end

agent.run_loop(user_message: question)

# To review the entire conversation:
# puts agent.log
