#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only. The pikuri
# gem ships as a library; this script is not installed by `gem install
# pikuri`. It exists to demonstrate how to wire Pikuri::Agent +
# Pikuri::Tool::* + Pikuri::Mcp::Servers into a working assistant binary
# with access to OAuth-gated SaaS via MCP, and to support development.
# Production binaries built on pikuri (e.g. the planned pikuri-tui)
# live in their own gems.
#
# This binary differs from `pikuri-chat` in three places:
#   * +prompts/pikuri-assistant.txt+ — assistant voice + MCP-aware
#     guidance.
#   * The +Mcp::Registry+ block below — hand-edit to add MCP servers
#     (id + argv pair). Empty by default so a fresh checkout runs
#     identically to `pikuri-chat` until the user opts in.
#   * The MCP audit log fires at INFO via `Pikuri.logger_for('Mcp::Servers')`
#     once servers start.
#
# Pin Bundler to pikuri's own Gemfile so locked dependency versions win
# and the script works when invoked via a symlink (e.g. ~/.local/bin/
# pikuri-assistant) from any working directory. `__dir__` resolves
# through symlinks, so this points at the real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../Gemfile', __dir__)

require 'bundler/setup'
require 'optparse'
require 'yaml'
require 'reline' # line editing + history for the interactive prompt

require 'pikuri-assistant'
require 'pikuri-subagents'
require 'pikuri-extractors'
require 'pikuri-web'

# Example-only config: the LLM connection + provider API keys live verbatim
# in a YAML file the user owns — no CLI flags, never the environment (see
# AGENTS.md "Environment is not a secret store"). Shared by convention across
# the example scripts; chmod 600 it. Absent file ⇒ {} ⇒ built-in defaults.
# (Per-run choices like the prompt stay on the command line, not here.)
examples_config_path = File.expand_path('~/.pikuri-examples-config.yaml')
examples_config = File.exist?(examples_config_path) ? (YAML.safe_load_file(examples_config_path) || {}) : {}

# The search keys moved under the `search:` block: a stale top-level key here
# would just be ignored, silently meaning "no Brave".
stale_search_keys = examples_config.keys & %w[brave_search_api_key exa_api_key]
unless stale_search_keys.empty?
  abort "#{examples_config_path}: #{stale_search_keys.join(' / ')} moved under the " \
        '`search:` key (search: {brave_key:, exa_key:, engines: [...]}) — see book/chat.md'
end

server = examples_config['llm_server'] || 'http://localhost:8080'
model = examples_config['llm_model'] || 'unsloth/Qwen3.6-35B-A3B-GGUF'
streaming = false

custom_prompt = nil
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-assistant [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--system-prompt FILE', "Replace the built-in system prompt with FILE's contents " \
                                  '(extensions still append their own sections).') do |v|
    custom_prompt = File.read(v).rstrip
  end
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Explicit extractor opt-in (requiring the gem alone changes
# nothing): pikuri-extractors' sandboxed converter covers PDF and
# the office formats (DOCX / ODT / XLSX / PPTX / EPUB / RTF) in one
# registration, superseding the vector-DB chapter's in-process pikuri-pdf — on
# an egress-capable agent, parsing untrusted documents belongs in
# the networkless container. From here on web_scrape / fetch and
# any file-reading tool pick the formats up through the Extractor
# registry.
Pikuri::Extractors::DOCUMENTS.register

cancel_flag = Pikuri::Agent::Control::Cancellable.new

system_prompt = custom_prompt || Pikuri.prompts(:'pikuri-assistant', :'agent-loop')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

# Slash commands: prompt templates you invoke by typing /name, scanned from
# .pikuri/commands / .claude/commands under the current directory and $HOME.
# They cost nothing in the system prompt because the model is never told they
# exist — the REPL below expands one into your own turn. Both bases are
# unvouched here: unlike bin/pikuri-code this binary has no containment to
# reason from, so it makes no claim about who wrote the files (the trifecta
# banner grades them accordingly).
command_registry = Pikuri::Command::Registry.new(search_bases: [Dir.pwd, Dir.home])

# MCP servers available to the assistant. Hand-edit this array to add
# providers — id is what the LLM references via +mcp_connect("...")+.
# Two entry types: +StdioEntry+ for a local subprocess (argv to spawn)
# and +HttpEntry+ for a remote endpoint (url + optional headers). Empty
# by default; pikuri-assistant will behave identically to pikuri-chat
# until at least one entry is added here.
#
# == Examples
#
#   Pikuri::Mcp::Registry::StdioEntry.new(
#     id:      'maven-tools',
#     command: ['npx', 'mcp-maven-deps']
#   ),
#   Pikuri::Mcp::Registry::StdioEntry.new(
#     id:      'gmail',
#     command: ['npx', '@gongrzhe/server-gmail-autoauth-mcp']
#   ),
#   Pikuri::Mcp::Registry::HttpEntry.new(
#     id:      'hubspot',
#     url:     'https://mcp.example.com/v1',
#     headers: { 'Authorization' => "Bearer #{ENV.fetch('HUBSPOT_TOKEN')}" }
#   ),
mcp_registry = Pikuri::Mcp::Registry.new(entries: [
])

# Boot-time LLM work — synthesize_descriptions: + verify_mcp_servers:
# each run a one-shot thinker agent once per configured MCP server on a cold
# cache (description synthesis on servers without instructions, then
# the injection verifier on every server). Both honor cancel_flag,
# so trap SIGINT around Agent.new and a Ctrl+C unwinds startup on
# the next thinker pre-call check. Cached entries skip both passes entirely.
#
# The extension is constructed here (rather than inline inside the
# block) so we can read +mcp_ext.servers.live_ids+ for the startup
# banner below. The extension's +configure(c)+ runs synchronously
# inside the Configurator block, so by the time +Agent.new+ returns
# +mcp_ext.servers+ is set.
mcp_ext = Pikuri::Mcp::Extension.new(
  registry: mcp_registry,
  synthesize_descriptions: true,
  verify_mcp_servers: true
)

# Run one agent turn, trapping SIGINT only for the duration of the turn.
# Ctrl+C during a turn flips the agent's Cancellable flag — the next
# tool-call boundary raises Cancelled, which we rescue below to return to
# the prompt. Outside a turn (at the `> ` input) the default handler is
# restored so Ctrl+C still exits the REPL the way it did before.
def run_turn(agent, message)
  prev_trap = trap('INT') { agent.cancellable&.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener; nothing else to do.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

prev_boot_trap = trap('INT') { cancel_flag.cancel! }
begin
  agent = Pikuri::Agent.new(
    # Connection rides the transport's own RubyLLM::Context (not a global
    # RubyLLM.configure); from_openai_server normalizes a trailing /v1.
    transport: Pikuri::Agent::ChatTransport.from_openai_server(
      server: server,
      model: model,
      api_key: examples_config.fetch('llm_api_key', 'not-needed')
    ),
    system_prompt: system_prompt,
    cancellable: cancel_flag,
    streaming: streaming
  ) do |c|
    c.add_listener Pikuri::Agent::Listener::Terminal.new(streaming: streaming)
    c.add_listener Pikuri::Agent::Listener::TokenLog.new
    c.add_tool Pikuri::Web::Search.from_h(examples_config['search'])
    c.add_tool Pikuri::Tool::CALCULATOR
    c.add_tool Pikuri::Web::SCRAPE
    c.add_tool Pikuri::Web::FETCH
    c.add_extension mcp_ext
    c.add_extension Pikuri::Command::Extension.new(registry: command_registry)
    c.add_extension Pikuri::SubAgent::Extension.new(personas: [Pikuri::SubAgent::RESEARCHER])
  end
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  warn 'Cancelled during startup'
  exit 130
ensure
  trap('INT', prev_boot_trap || 'DEFAULT')
end
# The cancel flag may have been left in a tripped state if the user
# pressed Ctrl+C between MCP synthesis calls — the trap fired but
# Agent.new finished before the next thinker pre-call check could raise. Reset
# so the first turn doesn't inherit a stale cancellation.
cancel_flag.reset!

begin
  # Capability + trifecta map, printed unconditionally. These are teaching
  # binaries and the map is half the lesson; a production host puts it behind
  # an explicit ask instead.
  puts agent.trifecta.render
  puts
  puts 'Pikuri Assistant. Press Ctrl+C or Ctrl+D to quit.'
  unless command_registry.empty?
    names = command_registry.list.map { |cmd| "/#{cmd.name}#{cmd.refused? ? ' (unavailable)' : ''}" }
    puts "Commands: #{names.sort.join(', ')}"
  end
  if mcp_ext.servers && !mcp_ext.servers.empty?
    puts "MCP servers connected: #{mcp_ext.servers.live_ids.join(', ')}"
  end

  run_turn(agent, ARGV.join(' ')) unless ARGV.empty?

  loop do
    line = Reline.readline('> ', true) # arrow-key history + line editing
    break if line.nil? # Ctrl+D / EOF on empty line

    message = line.chomp
    next if message.strip.empty?

    # A typed /name expands into an ordinary user turn — you wrote it, the
    # template just saved you the typing. Nothing is sent to the model until
    # the expansion succeeds.
    if message.start_with?('/')
      name, arguments = message[1..].split(/\s+/, 2)
      next if name.nil? || name.empty?

      expanded =
        begin
          command_registry.expand(name, arguments: arguments.to_s)
        rescue Pikuri::Command::RefusedError => e
          puts "/#{name} is unavailable — #{e.message}"
          next
        end

      if expanded.nil?
        puts "No such command: /#{name}."
        next
      end

      message = expanded
    end

    run_turn(agent, message)
  end
rescue Interrupt
  # Ctrl+C — fall through to clean exit
ensure
  agent.close
end

puts

