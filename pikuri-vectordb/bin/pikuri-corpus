#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only. The pikuri
# gem ships as a library; this script is not installed by `gem install
# pikuri-vectordb`. It exists to demonstrate local-corpus vector search:
# a single chat agent whose only tools are `vectordb_search` (semantic
# recall over an indexed corpus), `vectordb_read` (read one indexed
# document in full by its source path) and `calculator`. It has NO
# egress — no web search, no page fetch — by design: the corpus may hold
# private data, and an agent that can read it must not also be able to
# send it out. That single rule keeps all three legs of the lethal
# trifecta off this agent (chapter 6), and is why a prompt-injected
# document has no hand to act with — vectordb_search and vectordb_read
# are both inbound-only. The default corpus is the +docs/guide/+
# directory inside this checkout, so the reader can ask the agent about
# the very book they're reading.
#
# The privilege-separated `LIBRARIAN` persona is bundled by this gem but
# deliberately NOT wired here — it earns its keep only under an agent
# that *does* have egress (the chapter-7 assistant), where the corpus
# must be quarantined in a sub-agent. See docs/guide/03-vectordb.md.
#
# Same Bundler bootstrap pattern as the other bundled bins so callers
# don't need the `bundle exec` ceremony.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../Gemfile', __dir__)

require 'bundler/setup'
require 'optparse'

require 'pikuri-core'
require 'pikuri-vectordb'

server          = 'http://localhost:8080'
model           = 'unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M'
embed_model     = 'nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0'
reranker_server = nil # defaults to +server+; override for a separate reranker host
reranker_model  = 'gpustack/bge-reranker-v2-m3-GGUF:Q8_0'
use_reranker    = true
source          = File.expand_path('../../docs/guide', __dir__)
api_key_env     = 'OPENAI_API_KEY'
streaming       = false
watch           = false
use_chroma      = false

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-corpus [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--server URL', "llama-server base URL — chat, embedder, and reranker by default (default: #{server})") { |v| server = v }
  opts.on('--model NAME', "Chat model identifier (default: #{model})") { |v| model = v }
  opts.on('--embed-model NAME', "Embedding model identifier (default: #{embed_model})") { |v| embed_model = v }
  opts.on('--reranker-server URL', 'Reranker base URL (default: same as --server)') { |v| reranker_server = v }
  opts.on('--reranker-model NAME', "Reranker model identifier (default: #{reranker_model})") { |v| reranker_model = v }
  opts.on('--no-reranker', 'Skip the reranker; use vector-only top-k') { use_reranker = false }
  opts.on('--source PATH', "Corpus path to index (default: #{source})") { |v| source = v }
  opts.on('--watch', 'Keep the index live: reindex files as they change on disk (auto-watch daemon)') { watch = true }
  opts.on('--chroma', 'Persist the index in a self-managed ChromaDB container (requires docker) instead of in-RAM InMemory') { use_chroma = true }
  opts.on('--api-key-env VAR', "Env var holding the API key (default: #{api_key_env})") { |v| api_key_env = v }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

server          = server.chomp('/')
reranker_server = (reranker_server || server).chomp('/')
openai_api_base = "#{server}/v1"

# A single +llama-server+ running in router mode serves all three
# models — chat, embedder, and reranker — and dispatches each
# request to the matching cached GGUF. RubyLLM's OpenAI provider
# shares one +openai_api_base+ between +RubyLLM.chat+ and
# +RubyLLM.embed+, which is fine here because both naturally live
# at +server+. The reranker is *not* an OpenAI-shape call (it goes
# through +Reranker::LlamaServer+ against +POST /v1/rerank+) so it
# takes its own endpoint argument — defaulted to +server+ above,
# overridable via +--reranker-server+ if you'd rather keep the
# reranker pinned in its own llama-server instance instead of
# sharing the router's swap budget.
RubyLLM.configure do |c|
  c.openai_api_base           = openai_api_base
  c.openai_api_key            = ENV.fetch(api_key_env, 'not-needed')
  c.default_embedding_model   = embed_model
end

llama_probe_url = "#{server}/props"

cancel_flag = Pikuri::Agent::Control::Cancellable.new

system_prompt = Pikuri.prompt(:'pikuri-corpus')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"
system_prompt += "\nIndexed corpus root: #{source}"

reranker = use_reranker ? Pikuri::VectorDb::Reranker::LlamaServer.new(
  endpoint: reranker_server,
  model:    reranker_model
) : nil

# Mirror the chat-side +assume_model_exists: true+ so RubyLLM's
# local model registry doesn't reject the router's HF-repo-style
# embed model id (+RubyLLM.embed+ otherwise raises
# +ModelNotFoundError+ before any HTTP call). Provider is
# required by RubyLLM whenever +assume_model_exists+ is set.
embedder = Pikuri::VectorDb::Embedder.new(
  model:               embed_model,
  provider:            :openai,
  assume_model_exists: true
)

# Backend choice. InMemory (default) is RAM-only and re-indexes from
# scratch every run. --chroma instead spins up a self-managed ChromaDB
# container (via Server::Chroma, which routes docker through
# Pikuri::Subprocess and registers its `docker stop` with
# Pikuri::Finalizers, so it's torn down at process exit) and persists
# the embeddings to disk — so a corpus you index once stays indexed
# across runs.
backend =
  if use_chroma
    begin
      Pikuri::VectorDb::Server::Chroma.ensure_running.client(collection: 'pikuri-corpus')
    rescue StandardError => e
      warn "Could not start ChromaDB: #{e.message}"
      warn 'Is docker installed and running? Drop --chroma to use the in-memory backend.'
      exit 1
    end
  else
    Pikuri::VectorDb::Backend::InMemory.new
  end

# Hoisted to a local so the optional --watch daemon can be built around
# the *same* Indexer (and therefore the same backend) the agent uses.
# The extension indexes nothing on its own — population is the host's
# call. This demo deliberately starts WITHOUT auto-indexing: the exercise
# is to ask the agent to index the corpus (it calls vectordb_reindex).
# With InMemory that means an empty corpus every run; with --chroma the
# index may already be populated from a previous run. Pass --watch to
# have the Watcher build the index in the background and keep it live.
vectordb_ext = Pikuri::VectorDb::Extension.new(
  backend:  backend,
  source:   source,
  embedder: embedder,
  reranker: reranker
)

agent = Pikuri::Agent.new(
  transport: Pikuri::Agent::ChatTransport.new(
    model: model,
    provider: :openai,
    assume_model_exists: true
  ),
  system_prompt: system_prompt,
  step_limit: Pikuri::Agent::Control::StepLimit.new(max: 20),
  cancellable: cancel_flag,
  llama_probe_url: llama_probe_url,
  streaming: streaming
) do |c|
  c.add_listener Pikuri::Agent::Listener::Terminal.new(streaming: streaming)
  c.add_listener Pikuri::Agent::Listener::TokenLog.new
  # Calculator is the only non-corpus tool: harmless (no egress, no
  # untrusted input) and it keeps the demo honest — "what's 1837 *
  # 4291?" shows the agent reaching past the corpus when warranted.
  # The web tools (web_search / web_scrape / fetch) are deliberately
  # absent: with the corpus as a stand-in for private data, an egress
  # tool on this same agent would complete the lethal trifecta.
  c.add_tool Pikuri::Tool::CALCULATOR
  # VectorDb::Extension registers +vectordb_search+, +vectordb_read+
  # and +vectordb_reindex+ and nothing more — it does not index. The
  # corpus starts empty; the agent fills it by calling
  # +vectordb_reindex+ when the user asks (or the --watch daemon
  # below fills it in the background).
  c.add_extension vectordb_ext
end

# Optional auto-watch daemon (--watch). Host-owned: its lifetime is this
# process, not the agent, so it's built here rather than inside the
# Agent.new block. It registers with Pikuri::Finalizers, so even on an
# unclean exit the listener is stopped at process teardown; we also close
# it explicitly below. The daemon's worker thread calls backend.replace_source
# while the agent's turn calls backend.query — InMemory's monitor makes
# that concurrency safe.
watcher = nil
if watch
  watcher = Pikuri::VectorDb::Watcher.new(indexer: vectordb_ext.indexer).start
end

# Trap SIGINT only for the duration of the agent's turn. Ctrl+C during
# a turn flips the Cancellable flag — the next tool-call boundary
# raises Cancelled, which we rescue below to return to the prompt.
# Outside a turn (at the `> ` input) the default handler is restored
# so Ctrl+C still exits the REPL the way it did before.
run_turn = lambda do |message|
  prev_trap = trap('INT') { cancel_flag.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener; nothing else to do.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

puts 'Pikuri Corpus: chat agent with semantic recall over an indexed corpus (no internet access).'
puts "Corpus: #{source}"
puts "Backend: #{use_chroma ? 'ChromaDB (persistent)' : 'InMemory (RAM-only)'}"
# backend.count is 0 for a fresh InMemory and for a Chroma collection
# that's never been indexed; positive for a Chroma corpus persisted by a
# previous run.
already_indexed = backend.count
if already_indexed.positive?
  puts "Index already populated (#{already_indexed} chunk(s) from a previous run). Ask away — or say \"reindex\" to refresh."
elsif !watch
  puts 'The corpus is NOT indexed yet. Ask me to "index the corpus" first (I will run vectordb_reindex), then ask away.'
end
if watch
  puts "Watching #{source} — reindexing files as they change. If the index is empty it's building in the background now (give it a moment)."
end
puts 'Try: "What does the pikuri guide say about how the RESEARCHER persona stops a prompt-injected web page from making it run bash?"'
puts 'Press Ctrl+C or Ctrl+D to quit.'

run_turn.call(ARGV.join(' ')) unless ARGV.empty?

begin
  loop do
    print '> '
    $stdout.flush
    line = $stdin.gets
    break if line.nil? # Ctrl+D / EOF on empty line

    message = line.chomp
    next if message.strip.empty?

    run_turn.call(message)
  end
rescue Interrupt
  # Ctrl+C — fall through to clean exit
end

puts
# Stop the daemon before the agent: halt indexing first, then release
# the agent's resources. (No Server::Chroma here; with one, it would be
# stopped after the watcher — the Finalizers LIFO order.)
watcher&.close
agent.close
puts 'Goodbye'
