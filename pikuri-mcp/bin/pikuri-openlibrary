#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only. The pikuri
# gem ships as a library; this script is not installed by `gem install
# pikuri-mcp`. It is the worked example of docs/guide/05-mcp.md: a
# minimal agent wired to exactly one MCP server — the community
# Open Library catalogue reader (https://github.com/8enSmith/mcp-open-library)
# running inside a locally-built Docker container.
#
# The registry below is HARDCODED on purpose. This binary exists so the
# chapter-5 reader can watch the pikuri-mcp machinery fire end-to-end
# (verifier pass, synthesizer pass, `mcp_connect` activation) without
# first editing anything. The "hand-edit your own registry" lesson lives
# in `pikuri-assistant`, which keeps an empty registry slot for that.
#
# The toolset is deliberately tiny: the Open Library MCP tools plus
# `calculator`, nothing else. The server talks to the public internet
# (an outbound leg) and returns catalogue text pikuri didn't author
# (untrusted content) — two legs of the lethal trifecta. The third leg,
# private data, is structurally absent: no files, no memory, no token,
# nothing of yours is wired in, so a misbehaving server has nothing to
# exfiltrate. Keep it that way — see docs/guide/06-security.md before
# bolting more tools onto this agent.
#
# Prerequisite: build the server image once (the chapter walks through
# reading its source first):
#
#   git clone https://github.com/8enSmith/mcp-open-library
#   cd mcp-open-library && docker build -t mcp-open-library .
#
# Same Bundler bootstrap as the other bundled bins so callers don't need
# the `bundle exec` ceremony.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../Gemfile', __dir__)

require 'bundler/setup'
require 'optparse'
require 'yaml'

require 'pikuri-core'
require 'pikuri-mcp'

# Example-only config: the LLM connection + provider API keys live verbatim
# in a YAML file the user owns — no CLI flags, never the environment (see
# CLAUDE.md "Environment is not a secret store"). Shared by convention across
# the example scripts; chmod 600 it. Absent file ⇒ {} ⇒ built-in defaults.
examples_config_path = File.expand_path('~/.pikuri-examples-config.yaml')
examples_config = File.exist?(examples_config_path) ? (YAML.safe_load_file(examples_config_path) || {}) : {}

server = examples_config['llm_server'] || 'http://localhost:8080'
model = examples_config['llm_model'] || 'unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M'
streaming = false

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-openlibrary [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

server = server.chomp('/')
openai_api_base = "#{server}/v1"

RubyLLM.configure do |c|
  c.openai_api_base = openai_api_base
  c.openai_api_key  = examples_config.fetch('llm_api_key', 'not-needed')
end

cancel_flag = Pikuri::Agent::Control::Cancellable.new

system_prompt = Pikuri.prompt(:'pikuri-openlibrary')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

# The one hardcoded MCP server. The argv is the exact `docker run`
# command the chapter smoke-tests by hand: `-i` keeps stdin open for the
# JSON-RPC pipe, `--rm` deletes the container when the agent closes, and
# `node ./build/index.js` overrides the image's default mcp-proxy
# wrapper — pikuri speaks stdio directly, no HTTP proxy wanted. To
# pikuri this is just a subprocess that speaks MCP; the container is the
# isolation boundary around the server's 401-package npm dependency
# tree.
mcp_registry = Pikuri::Mcp::Registry.new(entries: [
  Pikuri::Mcp::Registry::StdioEntry.new(
    id:      'openlibrary',
    command: ['docker', 'run', '-i', '--rm',
              'mcp-open-library', 'node', './build/index.js']
  )
])

# Boot-time LLM work — synthesize_descriptions: + verify_mcp_servers:
# each run a one-shot thinker agent once on a cold cache (the Open Library server
# ships no useful `instructions`, so the synthesizer fires; the verifier
# fires on every server). Both honor cancel_flag, so trap SIGINT around
# Agent.new and a Ctrl+C unwinds startup on the next thinker pre-call check.
# Cached entries skip both passes entirely.
mcp_ext = Pikuri::Mcp::Extension.new(
  registry: mcp_registry,
  synthesize_descriptions: true,
  verify_mcp_servers: true
)
prev_boot_trap = trap('INT') { cancel_flag.cancel! }
begin
  agent = Pikuri::Agent.new(
    transport: Pikuri::Agent::ChatTransport.new(
      model: model,
      provider: :openai,
      assume_model_exists: true
    ),
    system_prompt: system_prompt,
    # :synthesize — this is a Q&A agent: when the budget trips, salvage an
    # answer from the evidence gathered so far instead of raising. (Coding
    # agents take the default :raise — see bin/pikuri-code.)
    step_limit: Pikuri::Agent::Control::StepLimit.new(max: 20, on_exhausted: :synthesize),
    cancellable: cancel_flag,
    streaming: streaming
  ) do |c|
    c.add_listener Pikuri::Agent::Listener::Terminal.new(streaming: streaming)
    c.add_listener Pikuri::Agent::Listener::TokenLog.new
    # Calculator is the only bundled tool. No web tools, no files, no
    # memory — the private-data leg of the trifecta stays amputated
    # (see the header comment).
    c.add_tool Pikuri::Tool::CALCULATOR
    c.add_extension mcp_ext
  end
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  warn 'Cancelled during startup'
  exit 130
ensure
  trap('INT', prev_boot_trap || 'DEFAULT')
end
# The cancel flag may have been left in a tripped state if the user
# pressed Ctrl+C between MCP synthesis calls — the trap fired but
# Agent.new finished before the next thinker pre-call check could raise. Reset
# so the first turn doesn't inherit a stale cancellation.
cancel_flag.reset!

# A spawn failure (missing image, docker not running) is logged as a
# warning by Mcp::Servers and the server is skipped — the agent would
# boot with no MCP tools at all, which defeats the whole demo. Fail
# loud with the build hint instead.
unless mcp_ext.servers.live_ids.include?('openlibrary')
  agent.close
  warn 'The Open Library MCP server failed to start (see the warning above).'
  warn 'Is docker running, and did you build the server image? One-time setup:'
  warn '  git clone https://github.com/8enSmith/mcp-open-library'
  warn '  cd mcp-open-library && docker build -t mcp-open-library .'
  warn 'docs/guide/05-mcp.md is the full walkthrough.'
  exit 1
end

# Trap SIGINT only for the duration of the agent's turn. Ctrl+C during a
# turn flips the Cancellable flag — the next tool-call boundary raises
# Cancelled, which we rescue below to return to the prompt. Outside a
# turn (at the `> ` input) the default handler is restored so Ctrl+C
# still exits the REPL the way it did before.
run_turn = lambda do |message|
  prev_trap = trap('INT') { cancel_flag.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener; nothing else to do.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

puts 'Pikuri Open Library: a one-MCP demo agent over the public Open Library book catalogue.'
puts 'Try: "What editions of The Hobbit are there?" or "What did Ursula K. Le Guin write?"'
puts 'Press Ctrl+C or Ctrl+D to quit.'

run_turn.call(ARGV.join(' ')) unless ARGV.empty?

begin
  loop do
    print '> '
    $stdout.flush
    line = $stdin.gets
    break if line.nil? # Ctrl+D / EOF on empty line

    message = line.chomp
    next if message.strip.empty?

    run_turn.call(message)
  end
rescue Interrupt
  # Ctrl+C — fall through to clean exit
end

puts
# Fires the extension's on_close, which tears the MCP subprocess (and
# with it the --rm container) down.
agent.close
puts 'Goodbye'
