#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only. The pikuri
# gem ships as a library; this script is not installed by `gem install
# pikuri`. It exists to demonstrate how to wire Pikuri::Agent +
# Pikuri::Tool::* into a working coding binary, and to support development.
# Production binaries built on pikuri (e.g. the planned pikuri-tui) live
# in their own gems.
#
# Pin Bundler to pikuri's own Gemfile so locked dependency versions win
# and the script works when invoked via a symlink (e.g. ~/.local/bin/
# pikuri-code) from any working directory. `__dir__` resolves through
# symlinks, so this points at the real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../Gemfile', __dir__)

require 'bundler/setup'
require 'optparse'

require 'pikuri-core'
require 'pikuri-skills'
require 'pikuri-workspace'
require 'pikuri-mcp'
require 'pikuri-code'

sandbox_enabled = true
confirm_enabled = true
server = 'http://localhost:8080'
model = 'unsloth/Qwen3.6-35B-A3B-GGUF'
api_key_env = 'OPENAI_API_KEY'
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-code [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--no-sandbox', 'Disable the bubblewrap sandbox around bash commands.') { sandbox_enabled = false }
  opts.on('--no-confirm', 'Auto-approve every confirmation (skip the y/n prompt for writes + bash).') { confirm_enabled = false }
  opts.on('--yolo', 'Shorthand for --no-sandbox --no-confirm. Use only with an outer sandbox.') do
    sandbox_enabled = false
    confirm_enabled = false
  end
  opts.on('--server URL', "LLM server base URL (default: #{server})") { |v| server = v }
  opts.on('--model NAME', "Model identifier (default: #{model})") { |v| model = v }
  opts.on('--api-key-env VAR', "Env var holding the API key (default: #{api_key_env})") { |v| api_key_env = v }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Scan the user's skill directories (~/.pikuri/skills, ~/.claude/skills,
# ~/.agents/skills) and the project's (.pikuri/skills, .claude/skills,
# .agents/skills, walked up to the git root) so the LLM can load any
# matching skill on demand. Catalog roots are folded into the workspace's
# readable set below so the skill tool's sidecar +read+ flow works
# (catalogs themselves don't enforce filesystem access).
skill_catalog = Pikuri::Skill::Catalog::Bundled.discover(cwd: Dir.pwd)

# Workspace is captured once at startup; all file-touching tools share it.
# Anchor is the launch directory (project root). Readable additions:
# system toolchains (/usr, /opt, mise/cargo/m2/…) so the LLM can grep
# Ruby stdlib, JDK sources, dependency caches; skill catalog roots so
# the +read+ tool can load skill sidecars. temp: true mints an ephemeral
# writable playground (Dir.mktmpdir, removed at_exit) — exposed below in
# the system prompt so the LLM knows where to put junk (downloads, unzip
# targets, scratch artifacts).
workspace = Pikuri::Workspace::Filesystem.new(
  anchor:   Dir.pwd,
  readable: Pikuri::Code::ToolchainPaths.readable + skill_catalog.roots,
  temp:     true
)
confirmer = confirm_enabled ? Pikuri::Workspace::Confirmer::TERMINAL : Pikuri::Workspace::Confirmer::AUTO_APPROVE

# Bubblewrap sandbox wraps every Bash subprocess with a filesystem view
# constrained to workspace.readable / workspace.writable plus a curated
# OS-runtime baseline (/etc/ssl, /etc/resolv.conf, /etc/localtime, …).
# Probes `bwrap` at construction and raises if it isn't installed or the
# kernel lacks user-namespace support — fail-loud, so a host that
# expects the sandbox doesn't silently run without one. Disable with
# --no-sandbox / --yolo.
sandbox = if sandbox_enabled
            Pikuri::Code::Bash::Sandbox::Bubblewrap.new(workspace: workspace)
          else
            Pikuri::Code::Bash::Sandbox::NONE
          end

# Build the system prompt: static base + optional project context + footer.
# AGENTS.md wins over CLAUDE.md when both exist; lookup is relative to
# the workspace cwd (== Dir.pwd at this point).
system_prompt = Pikuri.prompt(:'coding-system-prompt')
md_path = ['AGENTS.md', 'CLAUDE.md'].find { |f| File.exist?(f) }
system_prompt += "\n\n# Project Context\n\n#{File.read(md_path)}" if md_path
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"
system_prompt += "\nCurrent working directory: #{workspace.cwd}"
system_prompt += "\nTemp dir (writable, ephemeral, cleared on exit): #{workspace.temp}"

server = server.chomp('/')
openai_api_base = "#{server}/v1"

RubyLLM.configure do |c|
  c.openai_api_base = openai_api_base
  c.openai_api_key  = ENV.fetch(api_key_env, 'not-needed')
end

# llama.cpp exposes the server's launched +n_ctx+ at +/props+ on the base
# host (NOT under +/v1+). Hand the derived URL to {Agent::ContextWindowDetector}
# so the +ctx=<used>/<cap>+ headline lights up against this local server,
# which is unknown to ruby_llm's bundled model registry.
llama_probe_url = "#{server}/props"

cancel_flag = Pikuri::Agent::Control::Cancellable.new

# MCP servers available to the assistant. Hand-edit this array to add
# providers — id is what the LLM references via +mcp_connect("...")+.
# Two entry types: +StdioEntry+ for a local subprocess (argv to spawn)
# and +HttpEntry+ for a remote endpoint (url + optional headers). Empty
# by default; pikuri-assistant will behave identically to pikuri-chat
# until at least one entry is added here.
#
# == Examples
#
#   Pikuri::Mcp::Registry::StdioEntry.new(
#     id:      'maven-tools',
#     command: ['npx', 'mcp-maven-deps']
#   ),
#   Pikuri::Mcp::Registry::StdioEntry.new(
#     id:      'gmail',
#     command: ['npx', '@gongrzhe/server-gmail-autoauth-mcp']
#   ),
#   Pikuri::Mcp::Registry::HttpEntry.new(
#     id:      'hubspot',
#     url:     'https://mcp.example.com/v1',
#     headers: { 'Authorization' => "Bearer #{ENV.fetch('HUBSPOT_TOKEN')}" }
#   ),
mcp_registry = Pikuri::Mcp::Registry.new(entries: [
])

# Boot-time LLM work — synthesize_descriptions: + verify_mcp_servers:
# each call Agent.think once per configured MCP server on a cold
# cache. Trap SIGINT around Agent.new so a Ctrl+C unwinds startup.
# See bin/pikuri-assistant for the same pattern.
prev_boot_trap = trap('INT') { cancel_flag.cancel! }
begin
  agent = Pikuri::Agent.new(
    transport: Pikuri::Agent::ChatTransport.new(
      model: model,
      provider: :openai,
      assume_model_exists: true
    ),
    system_prompt: system_prompt,
    step_limit: Pikuri::Agent::Control::StepLimit.new(max: 40),
    cancellable: cancel_flag,
    llama_probe_url: llama_probe_url
  ) do |c|
    c.add_listener Pikuri::Agent::Listener::Terminal.new
    c.add_listener Pikuri::Agent::Listener::TokenLog.new
    # File/shell tools first (declaration order biases some models toward
    # earlier tools, and this is the coding-relevant set); web + calculator
    # last as auxiliary. The `skill` tool, when the catalog is non-empty,
    # is appended by the Skill::Extension below.
    c.add_tool Pikuri::Workspace::Read.new(workspace: workspace)
    c.add_tool Pikuri::Workspace::Grep.new(workspace: workspace)
    c.add_tool Pikuri::Workspace::Glob.new(workspace: workspace)
    c.add_tool Pikuri::Workspace::Edit.new(workspace: workspace)
    c.add_tool Pikuri::Workspace::Write.new(workspace: workspace, confirmer: confirmer)
    c.add_tool Pikuri::Code::Bash.new(workspace: workspace, confirmer: confirmer, sandbox: sandbox)
    c.add_tool Pikuri::Tool::WEB_SEARCH
    c.add_tool Pikuri::Tool::WEB_SCRAPE
    c.add_tool Pikuri::Tool::FETCH
    c.add_tool Pikuri::Tool::CALCULATOR
    c.add_extension Pikuri::Skill::Extension.new(catalog: skill_catalog)
    c.add_extension Pikuri::Mcp::Extension.new(
      registry: mcp_registry,
      synthesize_descriptions: true,
      verify_mcp_servers: true
    )
    c.allow_sub_agent(max_steps: 20)
  end
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  warn 'Cancelled during startup'
  exit 130
ensure
  trap('INT', prev_boot_trap || 'DEFAULT')
end
# Reset in case the user pressed Ctrl+C between MCP synthesis calls — the
# trap fired but Agent.new finished before the next .think check could
# raise. Otherwise the first turn would inherit a stale cancellation.
cancel_flag.reset!

# Trap SIGINT only for the duration of the agent's turn. Ctrl+C during a
# turn flips the Cancellable flag — the next tool-call boundary raises
# Cancelled, which we rescue below to return to the prompt. Outside a
# turn (at the `> ` input) the default handler is restored so Ctrl+C
# still exits the REPL the way it did before.
run_turn = lambda do |message|
  prev_trap = trap('INT') { cancel_flag.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener; nothing else to do.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

puts "Pikuri Coding Agent. Working in #{workspace.cwd}. Press Ctrl+C or Ctrl+D to quit."
puts "Loaded project context from #{md_path}." if md_path
unless skill_catalog.empty?
  names = skill_catalog.list.map(&:name).sort.join(', ')
  puts "Loaded #{skill_catalog.list.size} skill(s): #{names}."
end
# Print reduced-safety status only when a layer is off. Silent at
# defaults; loud when something the user might want to know about has
# been disabled.
warnings = []
warnings << 'Sandbox: DISABLED.' unless sandbox_enabled
warnings << 'Confirmer: AUTO-APPROVE.' unless confirm_enabled
unless warnings.empty?
  warnings << 'Use only with an outer sandbox (docker / dev-container) or in a throwaway environment.'
  puts warnings.join(' ')
end

run_turn.call(ARGV.join(' ')) unless ARGV.empty?

begin
  loop do
    print '> '
    $stdout.flush
    line = $stdin.gets
    break if line.nil? # Ctrl+D / EOF on empty line

    message = line.chomp
    next if message.strip.empty?

    run_turn.call(message)
  end
rescue Interrupt
  # Ctrl+C — fall through to clean exit
end

puts
agent.close

