#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev tooling, for whoever develops pikuri. A Thunderbird running on the
# testbed's demo profile (pikuri-thunderbird/dev/testbed/build first), driven over
# Marionette, for live tests: add an event while it runs, open a compose
# window, see what a hand-off would show.
#
#   pikuri-thunderbird/dev/testbed/session start [--display]  # headless, or on its own Xvfb
#   pikuri-thunderbird/dev/testbed/session js FILE [ARG...]   # run chrome-context JS (- reads stdin); prints the JSON result
#   pikuri-thunderbird/dev/testbed/session screenshot OUT.png # --display sessions only
#   pikuri-thunderbird/dev/testbed/session stop               # a clean quit (checkpoints the WAL stores)
#   pikuri-thunderbird/dev/testbed/session status
#
# A hand-off needs no display; ready scripts in dev/testbed/js/:
#
#   session js pikuri-thunderbird/dev/testbed/js/handoff.js -compose 'to=a@b.example,body=Hi%0Athere'
#   session js pikuri-thunderbird/dev/testbed/js/compose-windows.js   # what the window shows
#   session js pikuri-thunderbird/dev/testbed/js/outgoing-mime.js     # what Send would emit; sends nothing
#   session js pikuri-thunderbird/dev/testbed/js/close-windows.js     # before the next one
#
# The script is a function body with Thunderbird's privileged globals
# (Services, ChromeUtils, Ci, Cr, MailServices); the ARGs are its first
# arguments, and it resolves by calling arguments[arguments.length - 1](value).
# Top-level await is a SyntaxError: wrap an async IIFE, as js/add-event.js
# does. One session at a time; it refuses while any other Thunderbird runs.

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../../Gemfile', __dir__)
require 'bundler/setup'
require 'fileutils'
require 'json'
require 'pikuri-core'

Dir[File.expand_path('../../../dev/demo-home/builder/*.rb', __dir__)].each { |f| require f }
Dir[File.expand_path('builder/*.rb', __dir__)].each { |f| require f }

cache_dir = Pikuri::Paths.cache.join('thunderbird-testbed')
FileUtils.mkdir_p(cache_dir)
state = cache_dir.join('session.json').to_s
session = Pikuri::Demo::Session.load(state)
command = ARGV.shift

case command
when 'start'
  abort "A session runs already (pid #{session.pid}); stop it first." if session
  pids = Pikuri::Demo::Target.running_pids
  abort "Thunderbird is running (pid #{pids.join(', ')}); quit it first." unless pids.empty?

  profile = Pikuri::Demo::Target.new.profile_dir
  abort "#{profile} isn't a built testbed; run pikuri-thunderbird/dev/testbed/build" unless
    File.file?(File.join(profile, Pikuri::Demo::Home::MARKER))

  log = cache_dir.join('session.log').to_s
  session = Pikuri::Demo::Session.start(profile_dir: profile, log: log, display: ARGV.include?('--display'))
  session.save(state)
  puts "Thunderbird pid #{session.pid}, Marionette port #{session.port}" \
       "#{", display #{session.display}" if session.display}. Log: #{log}"
when 'js'
  abort 'No session; run: pikuri-thunderbird/dev/testbed/session start' unless session
  file = ARGV.shift or abort 'Usage: session js FILE [ARG...] (FILE - reads stdin)'
  script = file == '-' ? $stdin.read : File.read(file)
  puts JSON.pretty_generate(session.execute(script, args: ARGV, timeout: 120))
when 'screenshot'
  abort 'No session; run: pikuri-thunderbird/dev/testbed/session start --display' unless session
  out = ARGV.shift or abort 'Usage: session screenshot OUT.png'
  session.screenshot(out)
  puts out
when 'stop'
  abort 'No session.' unless session
  session.quit
  FileUtils.rm_f(state)
  puts 'Stopped.'
when 'status'
  puts session ? "Running: pid #{session.pid}, port #{session.port}#{", display #{session.display}" if session.display}" : 'No session.'
else
  abort File.read(__FILE__)[/^# Dev tooling.*?(?=^\n)/m].gsub(/^# ?/, '')
end
