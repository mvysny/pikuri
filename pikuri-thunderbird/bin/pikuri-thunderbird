#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only, not installed
# by `gem install`. Demonstrates the full local-Thunderbird wiring: a single
# local agent that searches and reads the user's mail + calendar and can draft
# a reply for them to send. It never talks to the network and never sends: the
# outbound compose tool only opens a pre-filled Thunderbird compose window the
# user reviews and Sends themselves, so there is an egress leg but no
# *autonomous* egress — every send is a human action in Thunderbird's UI. That
# human gate is what keeps the trifecta from closing on its own. (The
# always-inbound, zero-egress-leg posture is still what Extension gives by
# default (both allow_ flags off) — and what bin/pikuri-corpus /
# bin/pikuri-memory demo; this binary opts the demo into the human-gated egress
# on purpose.)
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../Gemfile', __dir__)

require 'bundler/setup'
require 'optparse'
require 'yaml'
require 'reline' # line editing + history for the interactive prompt

require 'pikuri-thunderbird' # pulls in pikuri-core

profile_dir = nil

# Example-only config: LLM connection + keys live verbatim in a user-owned
# YAML file (see AGENTS.md "Environment is not a secret store"). chmod 600.
examples_config_path = File.expand_path('~/.pikuri-examples-config.yaml')
examples_config = File.exist?(examples_config_path) ? (YAML.safe_load_file(examples_config_path) || {}) : {}
server = examples_config['llm_server'] || 'http://localhost:8080'
model  = examples_config['llm_model']  || 'unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M'

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-thunderbird [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--profile-dir DIR', 'Thunderbird profile directory (overrides auto-discovery).') do |d|
    profile_dir = d
  end
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Thin identity base only — the mail/calendar usage guidance, untrusted-content
# policy, and draft-hand-off stance are contributed by Thunderbird::Extension's
# system_prompt_snippets (in lockstep with the allow_ flags wired below).
system_prompt = Pikuri.prompt(:thunderbird)
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

cancel_flag = Pikuri::Agent::Control::Cancellable.new

def run_turn(agent, message)
  prev_trap = trap('INT') { agent.cancellable&.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

begin
  agent = Pikuri::Agent.new(
    transport: Pikuri::Agent::ChatTransport.from_openai_server(
      server: server,
      model: model,
      api_key: examples_config.fetch('llm_api_key', 'not-needed')
    ),
    system_prompt: system_prompt,
    cancellable: cancel_flag
  ) do |c|
    c.add_listener Pikuri::Agent::Listener::Terminal.new
    c.add_listener Pikuri::Agent::Listener::TokenLog.new
    c.add_tool Pikuri::Tool::CALCULATOR
    # One extension wires the whole surface: mail search+read (if Gloda is
    # present), calendar search+read, and both human-gated outbound hand-offs
    # (compose a message, create a calendar event).
    c.add_extension Pikuri::Thunderbird::Extension.new(
      profile_dir: profile_dir, allow_compose_mail: true, allow_create_calendar_event: true
    )
  end
rescue Pikuri::Thunderbird::Profile::DiscoveryError => e
  warn "Thunderbird profile problem: #{e.message}"
  exit 1
end

begin
  # Capability + trifecta map, printed unconditionally. These are teaching
  # binaries and the map is half the lesson; a production host puts it behind
  # an explicit ask instead.
  puts agent.trifecta.render
  puts
  puts 'Pikuri Thunderbird assistant — searches your local mail + calendar and can draft a ' \
    'reply for you to send (opens the draft in Thunderbird; you need to press Send to actually send the e-mail). ' \
       'Ctrl+C / Ctrl+D to quit.'

  run_turn(agent, ARGV.join(' ')) unless ARGV.empty?

  loop do
    line = Reline.readline('> ', true)
    break if line.nil? # Ctrl+D / EOF

    message = line.chomp
    next if message.strip.empty?

    run_turn(agent, message)
  end
rescue Interrupt
  # Ctrl+C at the prompt — clean exit.
ensure
  agent.close
end

puts
